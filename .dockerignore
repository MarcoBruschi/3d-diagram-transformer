# Version control
.git
.gitignore
.gitattributes
.github

# Environment files and sensitive credentials (STRICT SECURITY - NEVER BUNDLE)
.env
.env.*
.env*.local
*.env
*.pem
*.key
*.cert
*.crt
credentials.json

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build output and caches
.next
out
build
dist
*.tsbuildinfo
next-env.d.ts.bak

# Testing and coverage
coverage
.nyc_output

# Temporary and system files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea
.vscode

# Docker files (prevent recursive context)
Dockerfile*
docker-compose*.yml
.dockerignore
DOCKER.md
*.log
