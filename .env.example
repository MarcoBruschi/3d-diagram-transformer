# 3D Diagram Transformer SaaS - Environment Configuration (Option B)

# Database - PostgreSQL 16 (matches docker-compose.yml)
DATABASE_URL="postgresql://diagram_user:diagram_secret_password@localhost:5432/diagram_db?schema=public&connection_limit=20"

# Redis Cache, Rate Limiting & Real-time Presence (matches docker-compose.yml)
REDIS_URL="redis://:redis_secret_password@localhost:6379"

# Authentication & Security
JWT_SECRET="replace-with-a-random-secure-secret-key-at-least-32-chars-long"
JWT_REFRESH_SECRET="replace-with-a-random-refresh-secret-key-at-least-32-chars-long"

# Google Gemini Vision & AI Reasoning (https://aistudio.google.com/)
# SOMENTE server-side — NUNCA expor com prefixo NEXT_PUBLIC_
GEMINI_API_KEY=""

# Stripe Billing
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO_MONTHLY="price_..." # R$ 89/mês
STRIPE_PRICE_PRO_YEARLY="price_..."  # R$ 69/mês (faturado anualmente)
